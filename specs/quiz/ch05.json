  "questions": [
    {
      "type": "single",
      "q": "「子网编址」的主要目的是：",
      "options": {"A": "提高传输速率", "B": "节约 IP 地址", "C": "实现加密", "D": "支持视频流"},
      "answer": "B",
      "explain": "子网编址通过把大网拆成小子网，减少地址浪费。"
    },
    {
      "type": "single",
      "q": "「子网掩码」中与 IP **网络号和子网号**对应的位为：",
      "options": {"A": "全 0", "B": "全 1", "C": "与 IP 相同", "D": "与 IP 相反"},
      "answer": "B",
      "explain": "子网掩码：网络号 + 子网号位为 1，主机号位为 0。"
    },
    {
      "type": "single",
      "q": "「子网号」是从 IP 地址的哪部分「借」来的？",
      "options": {"A": "网络号", "B": "主机号", "C": "全 0 字段", "D": "全 1 字段"},
      "answer": "B",
      "explain": "子网号是从**主机号**部分借位而来。"
    },
    {
      "type": "single",
      "q": "B 类网络默认子网掩码为 `255.255.0.0`；若借 8 位作子网号，新的子网掩码是：",
      "options": {"A": "255.255.0.0", "B": "255.255.255.0", "C": "255.255.240.0", "D": "255.255.128.0"},
      "answer": "B",
      "explain": "借 8 位：11111111 11111111 11111111 00000000 = 255.255.255.0。"
    },
    {
      "type": "single",
      "q": "「子网号」全「0」与全「1」的用途是：",
      "options": {"A": "正常子网号", "B": "保留不可分配", "C": "用于广播", "D": "用于回送"},
      "answer": "B",
      "explain": "标准子网编址中，子网号全 0 和全 1 保留不可分配。"
    },
    {
      "type": "single",
